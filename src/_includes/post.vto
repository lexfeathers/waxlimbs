---
layout: layout.vto
---
<div class="post-heading">
    <a href="/pages/blog" class="button">< Entries</a>
    <p class="author font-small">by {{ author }} on {{ date |> date("HUMAN_DATE")}}</p>

    {{ if tags }}
        <span class="font-small">Tags:</span>
        {{ for tag of tags }}
            <span class="tag font-small">{{ tag }}</span>
        {{ /for }}
    {{ /if }}

    <hr>
    
    {{ if show_table_of_contents }}
        {{ await comp.toc({
            open: false
        }) }}
    {{ /if }}
</div>

<article>
    {{ content |> safe }}
</article>

{{ if search.pages("type=post draft=false")?.length }}
    <div class="separator"></div>
{{ /if }}

{{ await comp.LatestPosts({
    count: 2
}) }}

<form action="https://api.staticforms.dev/submit" method="POST" class="contact-form">
	<input type="hidden" name="apiKey" value="sf_89543e964dde0f811c6d704f" />
	<input type="hidden" name="subject" value="Waxlimbs submission" />

	<label for="name">Name</label>
	<input type="text" name="name" id="name" placeholder="" required />

	<label for="email">Email</label>
    <input type="email" name="email" id="email" placeholder="" required />

	<label for="message">Message</label>
    <textarea name="message" id="message" placeholder="" rows="8" required></textarea>

	<button type="submit">Submit</button>
</form>

<script>
		const nameField = document.querySelector('#name');
		const emailField = document.querySelector('#email');
		const messageField = document.querySelector('#message');

		const placeholderName = "Jane Doe";
		const placeholderEmail = "me@example.com";
		const placeholderMessage = "Your message here";

		const randomNumber = Math.random();

		if (randomNumber <= 0.04) {
			nameField.setAttribute("placeholder", 'Beef Pingu Corbett Music');
			emailField.setAttribute("placeholder", 'beef-baby@givemefood.com');
			messageField.setAttribute("placeholder", 'tell waxlimbs to buy beef a treat :3c');
		} else if (randomNumber >= 0.05 && randomNumber <= 0.09) {

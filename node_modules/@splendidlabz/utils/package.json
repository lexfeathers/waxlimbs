{
  "name": "@splendidlabz/utils",
  "version": "1.23.0",
  "description": "",
  "license": "Elastic-2.0",
  "type": "module",
  "homepage": "https://splendidlabz.com/docs/utils",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/lib/index.cjs",
  "module": "./dist/esm/lib/index.js",
  "types": "./dist/types/lib/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.cts",
      "import": "./dist/esm/lib/index.js",
      "require": "./dist/cjs/lib/index.cjs"
    },
    "./lib/*": {
      "types": "./dist/types/lib/*.d.cts",
      "import": "./dist/esm/lib/*.js",
      "require": "./dist/cjs/lib/*.cjs"
    },
    "./lib/validate": {
      "types": "./dist/types/lib/validate/index.d.cts",
      "import": "./dist/esm/lib/validate/index.js",
      "require": "./dist/cjs/lib/validate/index.cjs"
    },
    "./dom": {
      "types": "./dist/types/dom/index.d.cts",
      "import": "./dist/esm/dom/index.js",
      "require": "./dist/cjs/dom/index.cjs"
    },
    "./dom/*": {
      "types": "./dist/types/dom/*.d.cts",
      "import": "./dist/esm/dom/*.js",
      "require": "./dist/cjs/dom/*.cjs"
    },
    "./node": {
      "types": "./dist/types/node/index.d.cts",
      "import": "./dist/esm/node/index.js",
      "require": "./dist/cjs/node/index.cjs"
    },
    "./node/*": {
      "types": "./dist/types/node/*.d.cts",
      "import": "./dist/esm/node/*.js",
      "require": "./dist/cjs/node/*.cjs"
    }
  },
  "scripts": {
    "lint": "eslint . --fix",
    "test": "npm run type-check && vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "build": "tsup --config tsup.config.mjs",
    "build:watch": "tsup --config tsup.config.mjs --watch",
    "dev": "npm run build:watch",
    "clean": "rm -rf dist",
    "countries": "node tools/generate-countries.js",
    "prepublishOnly": "npm run clean && npm run countries && npm run test && npm run build"
  },
  "author": "Zell Liew <zellwk@gmail.com>",
  "dependencies": {
    "deep-eql": "^5.0.2",
    "dompurify": "^3.4.0",
    "glob": "^13.0.6",
    "libphonenumber-js": "^1.13.13",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "marked": "^18.0.2",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-mangle": "^1.1.13",
    "postcode-validator": "^3.10.22",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@splendidlabz/eslint-config": "3.0.0",
    "esbuild": "^0.27.7",
    "np": "^11.1.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4",
    "world-countries": "^5.1.0"
  }
}

/**
 * Drop the keys holding nothing, as {@link isEmpty} reads it.
 *
 * @template {object} T
 * @overload
 * @param {T} obj Object to filter.
 * @param {object} [options]
 * @param {boolean} [options.shallow=false] Leave nested values alone.
 * @returns {OmitEmptyResult<T>} A copy without the empty keys. An array answers with an array, its element type stripped of `null` and `undefined` — the two entries this always drops.
 */
declare function omitEmpty<T extends unknown>(obj: T, options?: {
    shallow?: boolean;
}): OmitEmptyResult<T>;
/**
 * Drop the keys holding nothing.
 *
 * @template {object} T
 * @overload
 * @param {T} obj Object to filter.
 * @param {boolean} shallow Leave nested values alone.
 * @returns {OmitEmptyResult<T>} A copy without the empty keys.
 * @deprecated Pass `{ shallow: true }` instead. The boolean goes in 2.0.0.
 */
declare function omitEmpty<T extends unknown>(obj: T, shallow: boolean): OmitEmptyResult<T>;
type OmitEmptyResult<Value> = 0 extends (1 & Value) ? Partial<Value> : Value extends readonly (infer E)[] ? NonNullable<E>[] : Partial<Value>;

export { type OmitEmptyResult, omitEmpty };

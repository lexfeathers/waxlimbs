/**
 * debounce
 * Delays a callback until calls stop for `wait` ms.
 *
 * @param {Function} callback
 * @param {number | (() => number)} wait Delay, or a getter for it
 * @param {boolean} [immediate] Calls on the leading edge
 */
declare function debounce(callback: Function, wait: number | (() => number), immediate?: boolean): {
    (...args: any[]): void;
    cancel(): void;
};

export { debounce };

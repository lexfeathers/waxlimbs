{
  "name": "@splendidlabz/svelte",
  "type": "module",
  "version": "4.17.2",
  "license": "Elastic-2.0",
  "sideEffects": false,
  "homepage": "https://splendidlabz.com/docs/svelte",
  "scripts": {
    "lint": "eslint . --fix",
    "prepack": "vitest run",
    "release": "np --no-publish && npm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-check --tsconfig ./jsconfig.json --watch"
  },
  "author": "Zell Liew <zellwk@gmail.com>",
  "exports": {
    ".": {
      "svelte": "./components/index.js"
    },
    "./actions": "./actions/index.js",
    "./astro": "./astro/index.js",
    "./utils": "./utils/index.js"
  },
  "files": [
    "actions",
    "astro",
    "components",
    "utils",
    "!**/*.spec.js",
    "!**/*.test.js",
    "!components/DisclosureOld"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@iconify/svelte": "^5.2.1",
    "@splendidlabz/utils": "*"
  },
  "devDependencies": {
    "@splendidlabz/eslint-config": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "happy-dom": "^20.9.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.4.6",
    "vitest": "^4.1.4"
  }
}

{
  "name": "@lumeland/lume",
  "version": "4.0.2",
  "description": "A fast and flexible static site generator",
  "homepage": "https://lume.land/",
  "license": "MIT",
  "author": "Óscar Otero",
  "bin": {
    "lume": "./build/bin.js"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/src/mod.d.ts",
      "import": "./build/src/mod.js"
    },
    "./*.ts": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    },
    "./*.js": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    }
  },
  "dependencies": {
    "@lumeland/core": "^1.0.4",
    "@lumeland/plugin-dev": "^1.0.0",
    "@lumeland/plugin-json": "^1.0.0",
    "@lumeland/plugin-markdown": "^1.0.0",
    "@lumeland/plugin-modules": "^1.0.0",
    "@lumeland/plugin-paginate": "^1.0.0",
    "@lumeland/plugin-search": "^1.0.0",
    "@lumeland/plugin-toml": "^1.0.0",
    "@lumeland/plugin-url": "^1.0.0",
    "@lumeland/plugin-vento": "^1.0.0",
    "@lumeland/plugin-yaml": "^1.0.0",
    "cac": "^7.1.0",
    "deno-std": "^1.6.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@lumeland/ssx": "^0.1.16"
  },
  "allowScripts": {
    "fsevents": false
  }
}
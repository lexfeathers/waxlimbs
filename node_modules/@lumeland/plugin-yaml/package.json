{
  "name": "@lumeland/plugin-yaml",
  "version": "1.0.0",
  "description": "Plugin to add support for YAML to store data and create pages.",
  "keywords": [
    "lume-plugin"
  ],
  "homepage": "https://lume.land/plugins/yaml/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/src/mod.d.ts",
      "import": "./build/src/mod.js"
    },
    "./*.ts": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    },
    "./*.js": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    }
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.0"
  }
}
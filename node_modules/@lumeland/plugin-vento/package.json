{
  "name": "@lumeland/plugin-vento",
  "version": "1.0.0",
  "description": "Plugin to use the Vento template engine to create pages and layouts.",
  "keywords": [
    "lume-plugin"
  ],
  "homepage": "https://lume.land/plugins/vento/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/src/mod.d.ts",
      "import": "./build/src/mod.js"
    },
    "./*.ts": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    },
    "./*.js": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    }
  },
  "dependencies": {
    "ventojs": "^2.4.2"
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.0"
  }
}
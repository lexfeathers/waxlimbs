{
  "name": "@lumeland/plugin-markdown",
  "version": "1.0.0",
  "description": "Plugin to create pages in Markdown format.",
  "keywords": [
    "lume-plugin"
  ],
  "homepage": "https://lume.land/plugins/markdown/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/src/mod.d.ts",
      "import": "./build/src/mod.js"
    },
    "./*.ts": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    },
    "./*.js": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-deflist": "^4.0.0"
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.0"
  }
}
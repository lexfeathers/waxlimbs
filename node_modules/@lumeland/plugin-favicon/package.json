{
  "name": "@lumeland/plugin-favicon",
  "version": "1.0.0",
  "description": "Plugin to create favicons automatically using a svg file as the source.",
  "keywords": [
    "lume-plugin"
  ],
  "homepage": "https://lume.land/plugins/favicon/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/src/mod.d.ts",
      "import": "./build/src/mod.js"
    },
    "./*.ts": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    },
    "./*.js": {
      "types": "./build/src/*.d.ts",
      "import": "./build/src/*.js"
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ico-endec": "^0.1.6",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@lumeland/core": "^1.0.0"
  }
}